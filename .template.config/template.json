{
  "$schema": "http://json.schemastore.org/template",
  "author": "ardalis (Steve Smith)",
  "classifications": [
    "Web",
    "ASP.NET",
    "Clean Architecture"
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "identity": "Ardalis.CleanArchitecture.Template",
  "name": "ASP.NET Clean Architecture Solution",
  "shortName": "clean-arch",
  "sourceName": "Clean.Architecture",
  "templateFileExtensions": [ ".cs", ".csproj", ".slnx" ],
  "preferNameDirectory": true,
  "symbols": {
    "AspireVersion": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "13.6.4",
      "description": "Aspire AppHost SDK version.",
      "replaces": "13.6.4",
      "onlyIf": [
        { "after": "Aspire.AppHost.Sdk/", "before": "\"" }
      ]
    },
    "AspireHostingSqlServerVersion": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "13.6.4",
      "description": "Aspire.Hosting.SqlServer package version.",
      "replaces": "13.6.4",
      "onlyIf": [
        { "after": "Include=\"Aspire.Hosting.SqlServer\" Version=\"", "before": "\"" }
      ]
    },
    "AspireHostingTestingVersion": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "13.6.4",
      "description": "Aspire.Hosting.Testing package version.",
      "replaces": "13.6.4",
      "onlyIf": [
        { "after": "Include=\"Aspire.Hosting.Testing\" Version=\"", "before": "\"" }
      ]
    },
    "AspireNuGetSource": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "description": "When supplied by Aspire CLI, use its generated NuGet feed policy."
    },
    "safeSourceName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "fileRename": "Clean.Architecture"
    }
  },
  "sources": [
    {
      "include": [
        "**/*"
      ],
      "exclude": [ 
        ".vs/**",
        ".vscode/**",
        ".git",
        ".git/**",
        ".github/**",
        ".idea/**",
        ".template.config/**",
        "docs/**",
        "sample/**",
        "MinimalClean/**",
        "**/bin/**",
        "**/obj/**"
      ],
      "modifiers": [
        {
          "condition": "(AspireNuGetSource != \"\")",
          "exclude": [ "nuget.config" ]
        },
        {
          "condition": "true",
          "copyOnly": [ "*.dll", "*.png", "*.ico", "*.jpg", "*.jpeg", "*.ps1" ]
        },
        {
          "rename": {
            "README.template.md": "README.md"
          }
        }
      ]
    }
  ]
}
